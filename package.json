{
  "name": "ms-inventario",
  "version": "1.0.0",
  "private": true,
  "description": "Microservicio de inventario de solo lectura para la Clase 7",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test test/*.test.js test/unit/*.test.js",
    "test:watch": "node --test --watch test/*.test.js test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
