# Copiar como .env y completar la URI con el usuario propio de Atlas.
# Nunca subir usuarios, contraseñas ni cadenas de conexión reales.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@HOST/?retryWrites=true&w=majority
MONGODB_DB=clase7_inventario
PORT=3000
SERVICE_NAME=ms-inventario-ibarra-bassi
CORS_ORIGIN=https://ms-ecommerce-dashboard.onrender.com
