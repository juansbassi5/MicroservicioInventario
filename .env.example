# Copiar este archivo como .env y completar los valores localmente.
# Cada integrante debe usar su propio usuario y contraseña de MongoDB Atlas.
# Nunca subir credenciales reales al repositorio.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@HOST_DEL_CLUSTER/?retryWrites=true&w=majority
MONGODB_DB=clase7_inventario
PORT=3000
SERVICE_NAME=ms-inventario-ibarra-bassi
CORS_ORIGIN=https://ms-ecommerce-dashboard.onrender.com
